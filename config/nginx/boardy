server {
    server_name kilqa.ai-info.ru;
    
    root /var/www/boardy;
    index index.html;

    access_log /var/log/nginx/boardy-access.log;
    error_log /var/log/nginx/boardy-error.log;

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/kilqa.ai-info.ru/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/kilqa.ai-info.ru/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    add_header Strict-Transport-Security "max-age=31536000" always;
}
server {
    if ($host = kilqa.ai-info.ru) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name kilqa.ai-info.ru;
    return 404; # managed by Certbot


}
